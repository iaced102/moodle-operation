db.courses.insertOne({"id": 1, name: "Hội nhập", content: "Khóa học giúp nhân viên nhanh chóng nắm bắt được các thông tin chung của doanh nghiệp", thumb_url: "https://bizfly-lms.hn.ss.bfcplatform.vn/course_thumb/hoi_nhap.png" , "highlight": ["Được format theo dạng TILES giúp người học dễ dàng theo dõi và nhận thức 1 cách logic các nội dung đào tạo.", "Khóa học được giởi hạn thời gian trong tuần đầu tiên của nhân viên mới, định nghĩa chi tiết và rõ ràng thời lượng đào tạo cần đạt được.", "Quy trình 1 lần áp dụng cho tất cả nhân viên mới, không phụ thuộc vào số lượng nhân viên cần đào tạo, hạn chế việc ảnh hưởng tiến độ đào tạo và tốc độ nắm bắt và phụ trách vị trí công việc mới của nhân viên. ", "Khóa học có đầy đủ các hạng mục đào tạo cần thiết cho 1 nhân viên mới, kèm sự đánh giá và phản hồi quan trọng về chất lượng dạy và học. Từ đó giúp ban quản trị bao quát và đưa ra các chiến lược đào tạo tối ưu nhất. ", "Các tính năng tương tác “forum, chat” phục vụ riêng cho mục “Hội nhập” sẽ giúp nhân viên mới hòa nhập với môi trường doanh nghiệp nhanh chóng và dễ dàng, tăng sự kết nối với các đồng nghiệp khác.", "Cấu trúc hiện đại,tối ưu , tiết kiệm chi phí so với mô hình đào tạo truyền thống rườm rà, tốn kém về tiền bạc và thời gian.", "Đặc biệt hỗ trợ công cụ H5P sẵn sàng cho việc biên soạn các video bài giảng dạng Interactive content  đem đến sự thú vị và thu hút học viên, linh hoạt trong việc học tập mọi lúc mọi nơi. Tích hợp các tính năng mới giúp cho nội dung đào tạo được đa dạng hóa."], "Routine": ["Tuần đầu tiên", "Kiểm tra kiến thức", "Đánh giá chất lượng", "Tài liệu tham khảo"], "course_preview": ["https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/1.1.jpg"]})
db.courses.insertOne({"id": 2, name: "Định hướng", content: "Giúp doanh nghiệp có được cái nhìn tổng quát về năng lực thực tế của nhân viên", thumb_url: "https://bizfly-lms.hn.ss.bfcplatform.vn/course_thumb/dinh_huong.png" , "highlight": ["Cung cấp đầy đủ các mẫu quy trình định hướng được nghiên cứu kỹ càng đáp ứng đào tạo định hướng nhân viên mới trong  tháng làm việc đầu tiên.", "Các đề mục khóa học đề xuất sẵn được định dạng theo kiểu TOPIC, TILES giúp người học xác định được các mục tiêu học tập cụ thể, rõ ràng.", "Các nội dung Định hướng được đề xuất sẵn và xác định đúng hướng, khoa học và tổng quan giúp nhân viên tăng tốc dễ dàng trong công việc mới. Như vậy các chi phí và thời gian đào tạo nhân sự mới cũng được giảm thiểu nhiều.", "Giảm lo lắng cho nhân viên mới: Khi quy trình đào tạo nhân viên mới được định hướng đúng và rõ ràng mạch lạc ngay từ ban đầu, nhân viên sẽ được giảm áp lực khi phụ trách công việc mới. Nhân viên tiếp cận định hướng mới nhanh chóng và tiếp thu hiệu quả hơn các hướng dẫn, không cần phỏng đoán, tránh căng thẳng.", "Các tính năng tương tác linh hoạt trong khóa học giúp kết nối giữa tổ chức đào tạo và người học trở nên gắn kết, từ đó cập nhật và tối ưu hóa các đầu mối công việc và nhiệm vụ mới", "Đặc biệt hỗ trợ công cụ H5P sẵn sàng cho việc biên soạn các video bài giảng dạng Interactive content  đem đến sự thú vị và thu hút học viên, linh hoạt trong việc học tập mọi lúc mọi nơi. Tích hợp các tính năng mới giúp cho nội dung đào tạo được đa dạng hóa."], "Routine": ["Sổ tay nhân sự", "Định hướng nhu cầu nhân sự mới", "Kho tài liệu tham khảo"], "course_preview": ["https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/2.1.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/2.2.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/2.3.jpg"]})
db.courses.insertOne({"id": 3, name: "Phát triển chuyên môn", content: "Giúp doanh nghiệp có được cái nhìn tổng quát về năng lực thực tế của nhân viên", thumb_url: "https://bizfly-lms.hn.ss.bfcplatform.vn/course_thumb/phat_trien_chuyen_mon.png" , "highlight": ["Course format: dạng TILES theo cấu trúc khối với ảnh và logo đại diện mô phỏng cho nội dung giúp học viên dễ dàng nắm bắt cấu trúc khóa học", "Các thành phần cấu trúc của mỗi khóa học được thiết kế theo dạng TOPIC rõ ràng và logic của mỗi khóa học: từ lý thuyết đến thực hành, bao quát và nâng cao hiệu quả tiếp thu.", "Lớp học trực tuyến tích hợp tự động với LMS giúp việc quản lý, theo dõi và báo cáo được tối ưu hóa. Giáo viên có thể lựa chọn tùy ý theo mục đích đào tạo bất cứ lúc nào. Các tính năng đầy đủ và toàn diện của lớp học trực tuyến đem đến các trải nghiệm mới, thu hút và tạo hứng thú học tập cao.", "Tính năng workshop và thực hành với tính năng thông báo và cố định thời hạn hoàn thành, giúp học viên dễ dàng quản lý theo dõi việc giao nộp bài tập đúng hạn.", "Tính năng tương tác đa dạng forum, messages, gia tăng sự kết nối và thu hẹp khoảng cách giữa người học với đơn vị đào tạo. Nâng cao hiệu quả kết hợp trong công việc", "Khu tài liệu tham khảo hỗ trợ cho việc chủ động học tập và tra cứu mọi lúc mọi nơi.", "Đặc biệt hỗ trợ công cụ H5P sẵn sàng cho việc biên soạn các video bài giảng dạng Interactive content  đem đến sự thú vị và thu hút học viên, linh hoạt trong việc học tập mọi lúc mọi nơi. Tích hợp các tính năng mới giúp cho nội dung đào tạo được đa dạng hóa."], "Routine": ["Kỹ thuật tích hợp liên ngành", "Kỹ thuật khóa học", "Kỹ thuật hệ thống", "Kỹ thuật cơ khí", "Kỹ thuật xây dựng", "An toàn thông tin"], "course_preview": ["https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/3.1.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/3.2.jpg"]})
db.courses.insertOne({"id": 4, name: "Phát triển kỹ năng mềm", content: "Hình thức đào tạo nhân sự này thường được áp dụng tại các doanh nghiệp", thumb_url: "https://bizfly-lms.hn.ss.bfcplatform.vn/course_thumb/ky_nang_mem.png" , "highlight": ["Hạng mục đào tạo có dạng EDWISER theo mục tiêu đào tạo từng hạng mục “ session” dễ theo dõi và dễ dàng tổng hợp kiến thức theo nội dung chuyên đề  của từng tuần.", "Các module cho hoạt động đào tạo và tài nguyên học tập đa dạng, phong phú, giúp nhanh chóng tối ưu hóa kiến thức và mục đích đào tạo của từng hạng mục chuyên biệt.", "Lớp học trực tuyến tích hợp tự động với LMS giúp việc quản lý, theo dõi và báo cáo được tối ưu hóa.Các tính năng đầy đủ và toàn diện của lớp học trực tuyến đem đến các trải nghiệm mới, thu hút và tạo hứng thú học tập cao.", "Khu workshop và thực hành với tính năng thông báo và cố định thời hạn hoàn thành, giúp học viên dễ dàng quản lý theo dõi việc giao nộp bài tập đúng hạn. ", "Tính năng tương tác đa dạng forum, messages, gia tăng sự kết nối và thu hẹp khoảng cách giữa người học với đơn vị đào tạo. Nâng cao hiệu quả kết hợp trong công việc", "Khu tài liệu tham khảo hỗ trợ cho việc chủ động học tập và tra cứu mọi lúc mọi nơi.", "Đặc biệt hỗ trợ công cụ H5P sẵn sàng cho việc biên soạn các video bài giảng dạng Interactive content  đem đến sự thú vị và thu hút học viên, linh hoạt trong việc học tập mọi lúc mọi nơi. Tích hợp các tính năng mới giúp cho nội dung đào tạo được đa dạng hóa."], "Routine": ["Kỹ năng mềm cho đội ngũ quản lý", "Kỹ năng mềm cho đội sales", "Kỹ năng mềm cho đội kỹ thuật", "Tổng quan định hướng kỹ năng mềm"], "course_preview": ["https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/4.1.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/4.2.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/4.3.jpg"]})
db.courses.insertOne({"id": 5, name: "Dịch vụ & sản phẩm", content: "Khóa học giúp nhân viên nhanh chóng nắm bắt được các thông tin chung của doanh nghiệp", thumb_url: "https://bizfly-lms.hn.ss.bfcplatform.vn/course_thumb/dv_san_pham.png", "highlight": ["Hạng mục đào tạo thiết kế theo dạng TILES theo từng khối hạng mục dịch vụ và sản phẩm khác nhau tương ứng với mô hình kinh doanh của doanh nghiệp giúp học viên xác định chính xác mục tiêu học tập và có cái nhìn tổng quan về khóa học của doanh nghiệp.", "Cấu trúc khóa học theo cấu trúc TOPIC phân định rõ ràng từng chủ đề đào tạo với thành phần hoạt động và tài nguyên tích hợp sẵn trong kho tính năng. Các khóa học được phân bổ khoa học, tối ưu hóa kiến thức theo từng mục: Từ giới thiệu chung, diễn đàn public  tới các mục về lý thuyết, bài giảng, thực hành và đánh giá, tổng kết, tài liệu tham khảo.", "Lớp học trực tuyến tích hợp tự động với LMS giúp việc quản lý, theo dõi và báo cáo được tối ưu hóa.Các tính năng đầy đủ và toàn diện của lớp học trực tuyến đem đến các trải nghiệm mới, thu hút và tạo hứng thú học tập cao.", "Khu workshop và thực hành với tính năng thông báo và cố định thời hạn hoàn thành, giúp học viên dễ dàng quản lý theo dõi việc giao nộp bài tập đúng hạn.", "Tính năng tương tác đa dạng forum, messages, gia tăng sự kết nối và thu hẹp khoảng cách giữa người học với đơn vị đào tạo. Nâng cao hiệu quả kết hợp trong công việc tại doanh nghiệp.", "Khu tài liệu tham khảo hỗ trợ cho việc chủ động học tập và tra cứu mọi lúc mọi nơi.", "Đặc biệt hỗ trợ công cụ H5P sẵn sàng cho việc biên soạn các video bài giảng dạng Interactive content  đem đến sự thú vị và thu hút học viên, linh hoạt trong việc học tập mọi lúc mọi nơi. Tích hợp các tính năng mới giúp cho nội dung đào tạo được đa dạng hóa."], "Routine": ["Tổng quan các sản phẩm", "Sản phẩm & Dịch vụ khối khách hàng B2B", "Sản phẩm & Dịch vụ khối khách hàng B2C"], "course_preview": ["https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/5.1.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/5.2.jpg"]})
db.courses.insertOne({"id": 6, name: "Tiêu chuẩn và chất lượng", content: "Giúp doanh nghiệp có được cái nhìn tổng quát về năng lực thực tế của nhân viên", thumb_url: "https://bizfly-lms.hn.ss.bfcplatform.vn/course_thumb/dt_tieu_chaun.png", "highlight": ["Định dạng hạng mục theo dạng TILES theo từng khối hạng mục đào tạo về tiêu chuẩn và chất lượng của chương trình đào tạo giúp học viên xác định chính xác mục tiêu học tập và có cái nhìn tổng quan về khóa học của doanh nghiệp.", "Cấu trúc khóa học theo chủ đề TOPIC phân định rõ ràng từng chủ đề đào tạo với thành phần hoạt động và tài nguyên tích hợp sẵn trong kho tính năng. Các khóa học được phân bổ khoa học, tối ưu hóa kiến thức theo từng mục: Từ giới thiệu chung, diễn đàn public  tới các mục về lý thuyết, bài giảng, thực hành và đánh giá, tổng kết, tài liệu tham khảo.", "Lớp học trực tuyến tích hợp tự động với LMS giúp việc quản lý, theo dõi và báo cáo được tối ưu hóa.Các tính năng đầy đủ và toàn diện của lớp học trực tuyến đem đến các trải nghiệm mới, thu hút và tạo hứng thú học tập cao.", "Khu workshop và thực hành với tính năng thông báo và cố định thời hạn hoàn thành, giúp học viên dễ dàng quản lý theo dõi việc giao nộp bài tập đúng hạn.", "Tính năng tương tác đa dạng forum, messages, gia tăng sự kết nối và thu hẹp khoảng cách giữa người học với đơn vị đào tạo. Nâng cao hiệu quả kết hợp trong công việc tại doanh nghiệp.", "Khu tài liệu tham khảo hỗ trợ cho việc chủ động học tập và tra cứu mọi lúc mọi nơi.", "Đặc biệt hỗ trợ công cụ H5P sẵn sàng cho việc biên soạn các video bài giảng dạng Interactive content  đem đến sự thú vị và thu hút học viên, linh hoạt trong việc học tập mọi lúc mọi nơi. Tích hợp các tính năng mới giúp cho nội dung đào tạo được đa dạng hóa."], "Routine": ["Tổng quan đào tạo tiêu chuẩn và chất lượng", "Quy trình kiểm soát chất lượng", "Kỹ thuật quan sát và đánh giá sản phẩm"], "course_preview": ["https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/6.1.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/6.2.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/6.3.jpg"]})
db.courses.insertOne({"id": 7, name: "An toàn và lao động", content: "Giúp doanh nghiệp có được cái nhìn tổng quát về năng lực thực tế của nhân viên", thumb_url: "https://bizfly-lms.hn.ss.bfcplatform.vn/course_thumb/an_toan_lao_dong.png" , "highlight": ["Định dạng hạng mục theo dạng TILES theo từng khối hạng mục dịch vụ và sản phẩm khác nhau của chương trình đào tạo giúp học viên xác định chính xác mục tiêu học tập và có cái nhìn tổng quan về khóa học của doanh nghiệp.", "Cấu trúc các khóa học theo cấu trúc TOPIC phân định rõ ràng từng chủ đề đào tạo với thành phần hoạt động và tài nguyên tích hợp sẵn trong kho tính năng. Các khóa học được phân bổ khoa học, tối ưu hóa kiến thức theo từng mục: Từ giới thiệu chung, diễn đàn public  tới các mục về lý thuyết, bài giảng, thực hành và đánh giá, tổng kết, tài liệu tham khảo.", "Lớp học trực tuyến tích hợp tự động với LMS giúp việc quản lý, theo dõi và báo cáo được tối ưu hóa.Các tính năng đầy đủ và toàn diện của lớp học trực tuyến đem đến các trải nghiệm mới, thu hút và tạo hứng thú học tập cao.", "Khu workshop và thực hành với tính năng thông báo và cố định thời hạn hoàn thành, giúp học viên dễ dàng quản lý theo dõi việc giao nộp bài tập đúng hạn.", "Tính năng tương tác đa dạng forum, messages, gia tăng sự kết nối và thu hẹp khoảng cách giữa người học với đơn vị đào tạo. Nâng cao hiệu quả kết hợp trong công việc tại doanh nghiệp.", "Khu tài liệu tham khảo hỗ trợ cho việc chủ động học tập và tra cứu mọi lúc mọi nơi.", "Đặc biệt hỗ trợ công cụ H5P sẵn sàng cho việc biên soạn các video bài giảng dạng Interactive content  đem đến sự thú vị và thu hút học viên, linh hoạt trong việc học tập mọi lúc mọi nơi. Tích hợp các tính năng mới giúp cho nội dung đào tạo được đa dạng hóa."], "Routine": ["Quyền và nghĩa vụ an toàn lao động", "Phòng cháy chữa cháy", "An toàn dịch vụ ăn uống", "An toàn xây dựng", "Sơ cứu cơ bản", "Tổng quan kiến thức an toàn lao động"], "course_preview": ["https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/7.1.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/7.2.jpg"]})
db.courses.insertOne({"id": 8, name: "Đội nhóm", content: "Hình thức đào tạo nhân sự này thường được áp dụng tại các doanh nghiệp", thumb_url: "https://bizfly-lms.hn.ss.bfcplatform.vn/course_thumb/dt_doi_nhom.png" , "highlight": ["Hạng mục thiết kế theo dạng TILES theo từng bộ phận khác nhau của các mô hình doanh nghiệp bám sát các mục tiêu đào tạo  theo đội nhóm giúp học viên xác định chính xác mục tiêu học tập và có cái nhìn tổng quan về khóa học của doanh nghiệp.", "Cấu trúc khóa học theo cấu trúc WEEKLY phân định rõ ràng theo thời gian đào tạo từng tuần, từng tháng với thành phần hoạt động và tài nguyên tích hợp sẵn trong kho tính năng. Các khóa học được phân bổ khoa học, tối ưu hóa kiến thức theo từng mục: Từ giới thiệu chung, diễn đàn public  tới các mục về lý thuyết, bài giảng, thực hành và đánh giá, tổng kết, tài liệu tham khảo.", "Lớp học trực tuyến tích hợp tự động với LMS giúp việc quản lý, theo dõi và báo cáo được tối ưu hóa.Các tính năng đầy đủ và toàn diện của lớp học trực tuyến đem đến các trải nghiệm mới, thu hút và tạo hứng thú học tập cao.", "Khu workshop và thực hành với tính năng thông báo và cố định thời hạn hoàn thành, giúp học viên dễ dàng quản lý theo dõi việc giao nộp bài tập đúng hạn.", "Tính năng tương tác đa dạng forum, messages, gia tăng sự kết nối và thu hẹp khoảng cách giữa người học với đơn vị đào tạo. Nâng cao hiệu quả kết hợp trong công việc tại doanh nghiệp.", "Khu tài liệu tham khảo hỗ trợ cho việc chủ động học tập và tra cứu mọi lúc mọi nơi.", "Đặc biệt hỗ trợ công cụ H5P sẵn sàng cho việc biên soạn các video bài giảng dạng Interactive content  đem đến sự thú vị và thu hút học viên, linh hoạt trong việc học tập mọi lúc mọi nơi. Tích hợp các tính năng mới giúp cho nội dung đào tạo được đa dạng hóa."], "Routine": ["Team quản lý, lãnh đạo", "Team kiểm định chất lượng", "Team marketing truyền thông", "Team đào tạo", "Team phát triển sản phẩm", "Team kinh doanh"], "course_preview": ["https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/8.1.jpg", "https://bizfly-lms.hn.ss.bfcplatform.vn/course_preview/8.2.jpg"]})


