package worker

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"os"
	"time"

	"moodle/internal/core/domain"

	"go.mongodb.org/mongo-driver/bson"
	"go.mongodb.org/mongo-driver/mongo"
	"go.mongodb.org/mongo-driver/mongo/options"
)

type DirInfo struct {
	MoodleID string
	Name     string
	Size     int64
}

func getMoodles(ctx context.Context, client *mongo.Client) ([]domain.Moodle, error) {
	coll := client.Database("moodle").Collection("moodles")
	cur, err := coll.Find(ctx, bson.M{})
	if err != nil {
		return nil, err
	}
	defer cur.Close(ctx)
	var moodles []domain.Moodle
	for cur.Next(ctx) {
		var m domain.Moodle
		if err := cur.Decode(&m); err != nil {
			return nil, err
		}
		moodles = append(moodles, m)
	}
	return moodles, nil
}

// Thêm struct và hàm lấy dữ liệu nfs_tracking

type NFSTracking struct {
	Path string `bson:"path" json:"path"`
	Size int64  `bson:"size" json:"size"`
}

type NFSTrackingDoc struct {
	Data []NFSTracking `bson:"data" json:"data"`
}

func getNFSTrackingMap(ctx context.Context, client *mongo.Client) (map[string]int64, error) {
	coll := client.Database("moodle").Collection("nfs_tracking")
	var doc NFSTrackingDoc
	err := coll.FindOne(ctx, bson.M{}).Decode(&doc)
	if err != nil {
		return nil, err
	}
	result := make(map[string]int64)
	for _, d := range doc.Data {
		if len(d.Path) >= 49 {
			moodleid := d.Path[13:49]
			result[moodleid] = d.Size
		}
	}
	return result, nil
}

// Thêm struct cho extend_storage

type ExtendStorage struct {
	MoodleID      string `bson:"moodleId"`
	ExtendStorage string `bson:"extend_storage"`
}

// Hàm lấy dung lượng mua thêm (GB, string) từ collection extend_storage
func getExtendStorage(ctx context.Context, client *mongo.Client, moodleId string) (int64, error) {
	coll := client.Database("moodle").Collection("extend_storage")
	var ext ExtendStorage
	err := coll.FindOne(ctx, bson.M{"moodleId": moodleId}).Decode(&ext)
	if err != nil {
		return 0, nil // Không có thì coi như 0
	}
	// Chuyển string sang int64 (GB)
	var gb int64 = 0
	fmt.Sscanf(ext.ExtendStorage, "%d", &gb)
	return gb, nil // Đổi GB sang byte
}

func sendTelegram(m domain.Moodle, currentStorage, totalLimit int64) error {
	fmt.Println(currentStorage, totalLimit)
	apiUrl := "https://tlg.dev.bizflycloud.vn/bot7294492154:AAGupe8M8gjj7EDqnNcEtu5oReWO0BqxM9g/sendMessage"
	text := fmt.Sprintf("[ALARM] KH: %s, Email: %s, Site: %s, Storage: %.2fGB/%.2fGB", m.Name, m.Email, m.WebSiteName, float64(currentStorage), float64(totalLimit))
	message := map[string]interface{}{
		"chat_id": -4762259932,
		"text":    text,
	}
	jsonValue, _ := json.Marshal(message)
	req, err := http.NewRequest("POST", apiUrl, bytes.NewBuffer(jsonValue))
	if err != nil {
		return err
	}
	req.Header.Set("Content-Type", "application/json")
	client := &http.Client{Timeout: 10 * time.Second}
	resp, err := client.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()
	if resp.StatusCode != 200 {
		return fmt.Errorf("telegram error: %s", resp.Status)
	}
	return nil
}

func main() {
	ctx := context.Background()
	mongoUri := os.Getenv("MONGO_URI")
	if mongoUri == "" {
		mongoUri = "mongodb://localhost:27017"
	}
	client, err := mongo.Connect(ctx, options.Client().ApplyURI(mongoUri))
	if err != nil {
		log.Fatal(err)
	}
	defer client.Disconnect(ctx)

	// Lấy toàn bộ dữ liệu một lần
	moodles, err := getMoodles(ctx, client)
	if err != nil {
		log.Fatal(err)
	}
	nfsMap, err := getNFSTrackingMap(ctx, client)
	if err != nil {
		log.Fatal(err)
	}

	// Xử lý so sánh và gửi cảnh báo
	for _, m := range moodles {
		current, ok := nfsMap[m.Id]
		if !ok {
			log.Printf("skip %s: not found in nfs_tracking", m.Id)
			continue
		}
		current = current / 1000000
		defaultLimit := int64(m.Packages.DocumentStorage)
		if current > defaultLimit {
			// Nếu vượt, kiểm tra extend_storage (GB)
			extBytes, _ := getExtendStorage(ctx, client, m.Id)
			totalLimit := defaultLimit + extBytes
			//fmt.Println(m.Name, current, defaultLimit, extBytes, totalLimit)
			if current > totalLimit {
				if err := sendTelegram(m, current, totalLimit); err != nil {
					log.Printf("send tele fail: %v", err)
				}
			}
		}
	}
}
